
# Ignore directories generated by Composer
/bin/
/drush/contrib/
/vendor/
# /docroot/core/
/docroot/modules/contrib/
/docroot/themes/contrib/
/docroot/profiles/contrib/
# /docroot/libraries/

# Ignore Drupal's file directory
/docroot/sites/*/files/

# Ignore scaffold files
/.editorconfig
/.gitattributes
/docroot/.csslintrc
/docroot/.eslintignore
/docroot/.eslintrc.json
/docroot/.gitignore
/docroot/.ht.router.php
/docroot/.htaccess
/docroot/INSTALL.txt
/docroot/README.md
/docroot/README.txt
/docroot/autoload.php
/docroot/example.gitignore
/docroot/index.php
/docroot/modules/README.txt
/docroot/profiles/README.txt
/docroot/robots.txt
/docroot/sites/README.txt
/docroot/sites/default/default.services.yml
/docroot/sites/default/default.settings.php
/docroot/sites/example.settings.local.php
/docroot/sites/example.sites.php
/docroot/themes/README.txt
/docroot/update.php
/docroot/docroot.config

# Ignore local settings
/docroot/sites/*/settings.local.php

# Ignore xdebug log file genearted by lando
xdebug.log

# Ignore Lando overrides
.lando.local.yml

# Ignore node
node_modules

# Ignore MacOS files
.DS_Store

# Ignore environment-specific .htaccess
.htaccess

# Ignore drush aliases for now
/drush/*

# Dev mode: don't include output styles.css 
styles.css

# Ignore settings.local.php for local developer ocverrides. 
docroot/sites/default/settings.local.php

# Ignore IDE files
/.env
.idea/
.vscode/
*.code-workspace

# Ignore DB dumps
*.sql
*.sql.gz
*.mysql
*.mysql.gz