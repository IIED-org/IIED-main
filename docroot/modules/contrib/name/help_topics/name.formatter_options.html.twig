<p>{% trans %}Formatter options control how the Name field is shown to site visitors.{% endtrans %}</p>

<h2>{% trans %}Main settings{% endtrans %}</h2>
<ul>
  <li>{% trans %}<strong>Name format</strong>: Picks the pattern used for each name.{% endtrans %}</li>
  <li>{% trans %}<strong>List format</strong>: Controls how multiple names are joined.{% endtrans %}</li>
  <li>{% trans %}<strong>Markup</strong>: Adds HTML wrappers to name parts for theme styling.{% endtrans %}</li>
  <li>{% trans %}<strong>Link target</strong>: Turns the rendered name into a link when possible.{% endtrans %}</li>
  <li>{% trans %}<strong>Preferred and alternative source</strong>: Uses data from other fields when configured.{% endtrans %}</li>
</ul>
