function name_get_format_by_machine_name($machine_name) {
  @trigger_error('name_get_format_by_machine_name() is deprecated in name:8.x-1.3 and is removed from name:2.0.0. Use \Drupal::service(\'name.format_options\')->getFormatPatternByMachineName() instead. See https://www.drupal.org/project/name/issues/3555260', E_USER_DEPRECATED);
  $id = FormatOptionService::normalizeLegacyFormatMachineName($machine_name);
  if ($id === NULL) {
