 *
 * Canonical types live in Drupal\name\Service or Drupal\name\Utility.
 *
 * @see \Drupal\name\Service\NameFormatterInterface
 * @see \Drupal\name\Service\GeneratorInterface
 * @see \Drupal\name\Service\AutocompleteService
 * @see \Drupal\name\Service\NameOptionService
 * @see \Drupal\name\Service\NameFormatParserService
 * @see \Drupal\name\Service\NameFormatterService
 * @see \Drupal\name\Service\GeneratorService
