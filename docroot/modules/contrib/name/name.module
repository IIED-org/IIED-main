/**
 * Implements hook_module_implements_alter().
 *
 * Runs hook_token_info_alter() for this module after the Token module so field
 * chain metadata (the subtree with given, family, etc.) is already present when
 * we attach the Formatted branch.
 */
function name_module_implements_alter(array &$implementations, string $hook): void {
  if ($hook !== 'token_info_alter' || !isset($implementations['name'])) {
    return;
  }
  $group = $implementations['name'];
  unset($implementations['name']);
  $implementations['name'] = $group;
}

