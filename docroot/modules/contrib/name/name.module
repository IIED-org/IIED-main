/**
 * Static cache to reuse translated name components.
 *
 * These have double encoding to allow easy and targeted string overrides.
 *
 * @param string[]|null $intersect
 *   An array of field component keys of the translations required.
 *
 * @return array
 *   Keyed array of the field component labels.
 *
 * @deprecated in name:8.x-1.3 and is removed from name:2.0.0. Use
 *   \Drupal::service('name.component_metadata')->getTranslations() instead.
 *
 * @see https://www.drupal.org/project/name/issues/3555260
 */
function _name_translations(?array $intersect = NULL) {
  @trigger_error('_name_translations() is deprecated in name:8.x-1.3 and is removed from name:2.0.0. Use \Drupal::service(\'name.component_metadata\')->getTranslations() instead. See https://www.drupal.org/project/name/issues/3555260', E_USER_DEPRECATED);
  $metadata = \Drupal::getContainer()
    ->get('name.component_metadata', ContainerInterface::NULL_ON_INVALID_REFERENCE);
  return $metadata ? $metadata->getTranslations($intersect) : [];
}

