// phpcs:ignore Drupal.Commenting.PostStatementComment.Found -- #[LegacyHook] is a PHP attribute, not a trailing comment.
#[LegacyHook] // @phpstan-ignore attribute.notFound
function name_help($route_name, RouteMatchInterface $route_match) {
  $help = \Drupal::getContainer()->get(
    HelpHooks::class,
    ContainerInterface::NULL_ON_INVALID_REFERENCE,
  );
  if ($help === NULL) {
    return [];
  }
  return $help->help($route_name, $route_match);
}

