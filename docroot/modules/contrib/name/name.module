  $token->alterTokenInfo($info);
}

/**
 * Implements hook_tokens().
 */
// phpcs:ignore Drupal.Commenting.PostStatementComment.Found -- #[LegacyHook] is a PHP attribute, not a trailing comment.
#[LegacyHook] // @phpstan-ignore attribute.notFound
function name_tokens(
  string $type,
  array $tokens,
  array $data,
  array $options,
  BubbleableMetadata $bubbleable_metadata,
): array {
  $token = \Drupal::getContainer()->get(
    TokenHooks::class,
    ContainerInterface::NULL_ON_INVALID_REFERENCE,
  );
  if ($token === NULL) {
    return [];
  }
  return $token->getChainReplacements(
    $type,
    $tokens,
    $data,
    $options,
    $bubbleable_metadata,
  );
}

/**
