<?php

/**
 * @file
 * The module that provides a set of utilities that make form theming easier.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\formdazzle\Hook\FormdazzleHooks;
use Drupal\Core\Form\FormStateInterface;
use Drupal\formdazzle\Dazzler;

/**
 * Implements hook_module_implements_alter().
 */
function formdazzle_module_implements_alter(array &$implementations, string $hook): void {
  Dazzler::moduleImplementsAlter($implementations, $hook);
}

/**
 * Implements hook_form_alter().
 */
#[LegacyHook]
function formdazzle_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  \Drupal::service(FormdazzleHooks::class)->formAlter($form, $form_state, $form_id);
}

/**
 * Implements hook_preprocess_HOOK().
 */
#[LegacyHook]
function formdazzle_preprocess_form_element(array &$variables): void {
  \Drupal::service(FormdazzleHooks::class)->preprocessFormElement($variables);
}
