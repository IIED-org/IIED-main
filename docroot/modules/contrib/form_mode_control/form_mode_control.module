<?php

/**
 * @file
 * Contains form_mode_control.module.
 */

use Drupal\Core\Entity\Display\EntityFormDisplayInterface;
use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\user\Entity\Role;
use Drupal\user\RoleInterface;

/**
 * Implements hook_entity_form_display_alter().
 */
function form_mode_control_entity_form_display_alter(EntityFormDisplayInterface &$formDisplay, array $context): void {
  $mode = NULL;
  switch ($context['form_mode']) {
    case 'default':
    case 'add':
      $mode = 'create';
      break;

    case 'edit':
    case 'entity_edit':
      $mode = 'update';
      break;
  }

  if ($context['entity_type'] === 'user' && $context['form_mode'] === 'default') {
    $mode = 'update';
  }
  if ($context['entity_type'] === 'user' && $context['form_mode'] === 'register') {
    $mode = 'create';
  }

  if (!$mode) {
    return;
  }

  // Assign the default form mode.
  $storage = \Drupal::entityTypeManager()
    ->getStorage('entity_form_display');
  $role = form_mode_control_get_role_id_with_max_weight();
  $defaults = \Drupal::configFactory()
    ->get('form_mode_control.settings')
    ->get('defaults');

  $defaultFormModeId = $defaults[$context['entity_type']][$context['bundle']][$mode][$role] ?? NULL;
  if ($defaultFormModeId) {
    $defaultFormDisplay = $storage->load($context['entity_type'] . '.' . $context['bundle'] . '.' . $defaultFormModeId);
    if ($defaultFormDisplay && $defaultFormDisplay->status()) {
      $formDisplay = $defaultFormDisplay;
    }
  }

  $formModeId = \Drupal::request()->query->get('display');
  if ($formModeId) {
    $chosenFormDisplay = $storage->load($context['entity_type'] . '.' . $context['bundle'] . '.' . $formModeId);
    if ($chosenFormDisplay && $chosenFormDisplay->status()) {
      $permission = form_mode_control_get_permission_by_mode_and_role($context['entity_type'], $context['bundle'], $formModeId);
      $hasPermission = \Drupal::currentUser()->hasPermission('access_all_form_modes')
        || ($permission && \Drupal::currentUser()->hasPermission($permission));

      if ($hasPermission) {
        $formDisplay = $chosenFormDisplay;
      }
    }
  }
}

/**
 * Implements hook_form_alter().
 */
function form_mode_control_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if ($form_id === 'entity_form_mode_add_form' || $form_id === 'entity_form_mode_edit_form') {
    $form['markup'] = [
      '#type' => 'markup',
      '#markup' => t('If you want to change to another form mode , add <strong style="color: #ff0000">?display=machine_name_form_mode.</strong>') . ' ',
    ];
  }
}

/**
 * Determine the permission for an entity type, form mode, and role.
 *
 * @param string $entityTypeId
 *   Machine name of the entity type.
 * @param string $bundle
 *   Machine name of the bundle.
 * @param string|null $formModeId
 *   Machine name of the form mode.
 *
 * @return string|null
 *   The configured permission or NULL if it was not found.
 */
function form_mode_control_get_permission_by_mode_and_role(string $entityTypeId, string $bundle, ?string $formModeId): ?string {
  if ($formModeId === NULL) {
    return NULL;
  }

  $id = "$entityTypeId.$bundle.$formModeId";
  if (!EntityFormDisplay::load($id)->status()) {
    return NULL;
  }

  return sprintf('use  The form mode %s linked to  %s entity( %s )', $formModeId, $entityTypeId, $bundle);
}

/**
 * Choose the maximum weight for current user's role.
 *
 * @return int|string
 *   A maximum weight value to use.
 */
function form_mode_control_get_role_id_with_max_weight() {
  // Get all roles.
  /** @var \Drupal\user\Entity\Role[] $all_role_entities */
  $all_role_entities = Role::loadMultiple();

  $all_id_roles = array_keys($all_role_entities);

  // Get roles of current user.
  $roles_current_user = \Drupal::currentUser()->getRoles();
  $roles_intersect = array_values(array_intersect($all_id_roles, $roles_current_user));

  // Get weight and id of the first role.
  $first_role = $roles_intersect[0];
  $max_weight = $all_role_entities[$first_role]->getWeight();
  $id_role_max_weight = $first_role;

  foreach ($roles_intersect as $id_role) {
    if ($all_role_entities[$id_role]->getWeight() > $max_weight) {
      // Use this role instead.
      $max_weight = $all_role_entities[$id_role]->getWeight();
      $id_role_max_weight = $id_role;
    }
  }

  return $id_role_max_weight;
}

/**
 * Implements hook_entity_delete().
 */
function form_mode_control_entity_delete(EntityInterface $entity): void {
  // Only process entity form displays and roles.
  if (!$entity instanceof EntityFormDisplayInterface && !$entity instanceof RoleInterface) {
    return;
  }

  $configuration = \Drupal::configFactory()
    ->getEditable('form_mode_control.settings');
  $defaults = $configuration->get('defaults');

  // Return early if no defaults are configured.
  if (empty($defaults)) {
    return;
  }

  $changed = FALSE;

  foreach ($defaults as $entityTypeId => $bundles) {
    foreach ($bundles as $bundle => $operations) {
      foreach ($operations as $operation => $roles) {
        foreach ($roles as $role => $formModeId) {
          $formDisplayId = $entityTypeId . '.' . $bundle . '.' . $formModeId;

          if ($entity instanceof EntityFormDisplayInterface && $entity->id() === $formDisplayId) {
            unset($defaults[$entityTypeId][$bundle][$operation][$role]);
            $changed = TRUE;
          }

          if ($entity instanceof RoleInterface && $role === $entity->id()) {
            unset($defaults[$entityTypeId][$bundle][$operation][$role]);
            $changed = TRUE;
          }
        }

        if ($defaults[$entityTypeId][$bundle][$operation] === []) {
          unset($defaults[$entityTypeId][$bundle][$operation]);
          $changed = TRUE;
        }
      }

      if ($defaults[$entityTypeId][$bundle] === []) {
        unset($defaults[$entityTypeId][$bundle]);
        $changed = TRUE;
      }
    }

    if ($defaults[$entityTypeId] === []) {
      unset($defaults[$entityTypeId]);
      $changed = TRUE;
    }
  }

  if (!$changed) {
    return;
  }

  $configuration->set('defaults', $defaults);
  $configuration->save();
}
