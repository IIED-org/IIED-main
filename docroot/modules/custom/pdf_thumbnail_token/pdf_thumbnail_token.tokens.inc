<?php

/**
 * @file
 * Bridges node tokens to Media PDF Thumbnail images generated from a
 * media entity referenced by the node.
 *
 * media_pdf_thumbnail's own token type ([media_pdf_thumbnail:...]) is a
 * standalone root token type. It cannot be reached by chaining through
 * [node:field_media:entity:...] because it always expects the entity
 * holding the PDF file field to already be present in the token
 * replacement context under the key 'media'. This module loads that
 * entity itself and calls Token::replace() internally, then exposes the
 * result as ordinary node tokens:
 *
 *   [node:pdf_thumbnail_uri]  - internal file URI, e.g. public://...
 *   [node:pdf_thumbnail_url]  - absolute, publicly accessible URL
 *
 * Adjust the constants below to match your site's field machine names.
 */

use Drupal\Core\Render\BubbleableMetadata;

/**
 * Machine name of the entity reference field on the node pointing to Media.
 */
const PDF_THUMBNAIL_TOKEN_MEDIA_FIELD = 'field_media';

/**
 * Machine name of the file field on the Media entity holding the PDF.
 */
const PDF_THUMBNAIL_TOKEN_PDF_FIELD = 'field_media_document';

/**
 * PDF page to render as the thumbnail (1-indexed, per media_pdf_thumbnail).
 */
const PDF_THUMBNAIL_TOKEN_PAGE = 1;

/**
 * Image format to generate: jpg, png, etc. (per media_pdf_thumbnail).
 */
const PDF_THUMBNAIL_TOKEN_FORMAT = 'jpg';

/**
 * Implements hook_token_info().
 */
function pdf_thumbnail_token_token_info() {
  $info = [];

  $info['tokens']['node']['pdf_thumbnail_uri'] = [
    'name' => t('PDF thumbnail (internal file URI)'),
    'description' => t('Internal file URI (e.g. public://...) of the PDF thumbnail generated by Media PDF Thumbnail for the media entity referenced by this node.'),
  ];

  $info['tokens']['node']['pdf_thumbnail_url'] = [
    'name' => t('PDF thumbnail (absolute URL)'),
    'description' => t('Absolute, publicly accessible URL of the PDF thumbnail generated by Media PDF Thumbnail for the media entity referenced by this node. Use this one in Metatag/metadata image fields.'),
  ];

  return $info;
}

/**
 * Implements hook_tokens().
 */
function pdf_thumbnail_token_tokens($type, $tokens, array $data, array $options, BubbleableMetadata $bubbleable_metadata) {
  $replacements = [];

  if ($type !== 'node' || empty($data['node'])) {
    return $replacements;
  }

  /** @var \Drupal\node\NodeInterface $node */
  $node = $data['node'];

  $wanted = array_intersect_key($tokens, array_flip(['pdf_thumbnail_uri', 'pdf_thumbnail_url']));
  if (empty($wanted)) {
    return $replacements;
  }

  if (!$node->hasField(PDF_THUMBNAIL_TOKEN_MEDIA_FIELD) || $node->get(PDF_THUMBNAIL_TOKEN_MEDIA_FIELD)->isEmpty()) {
    return $replacements;
  }

  $bubbleable_metadata->addCacheableDependency($node);

  /** @var \Drupal\media\MediaInterface|null $media */
  $media = $node->get(PDF_THUMBNAIL_TOKEN_MEDIA_FIELD)->entity;
  if (!$media) {
    return $replacements;
  }

  $bubbleable_metadata->addCacheableDependency($media);

  if (!$media->hasField(PDF_THUMBNAIL_TOKEN_PDF_FIELD) || $media->get(PDF_THUMBNAIL_TOKEN_PDF_FIELD)->isEmpty()) {
    return $replacements;
  }

  /** @var \Drupal\file\FileInterface|null $file */
  $file = $media->get(PDF_THUMBNAIL_TOKEN_PDF_FIELD)->entity;
  if (!$file) {
    return $replacements;
  }
  $bubbleable_metadata->addCacheableDependency($file);

  // Guard against file entities whose underlying file is missing from
  // disk (e.g. after a DB sync that didn't bring sites/default/files
  // along). Without this check, media_pdf_thumbnail_tokens() will try
  // to read the missing file and return FALSE from createThumbnail(),
  // which triggers a PHP 8.3 "array offset on false" warning on its
  // own line 100 when it does $infos[$value].
  $real_path = \Drupal::service('file_system')->realpath($file->getFileUri());
  if (!$real_path || !file_exists($real_path)) {
    \Drupal::logger('pdf_thumbnail_token')->warning('PDF file @uri (fid @fid) referenced by media @mid is missing from disk; skipping thumbnail generation.', [
      '@uri' => $file->getFileUri(),
      '@fid' => $file->id(),
      '@mid' => $media->id(),
    ]);
    return $replacements;
  }

  // Ask media_pdf_thumbnail to generate/return the thumbnail file URI, now
  // that we can give it a proper 'media' context.
  $inner_token = sprintf(
    '[media_pdf_thumbnail:%s:%d:%s:image_uri]',
    PDF_THUMBNAIL_TOKEN_PDF_FIELD,
    PDF_THUMBNAIL_TOKEN_PAGE,
    PDF_THUMBNAIL_TOKEN_FORMAT
  );

  try {
    $uri = \Drupal::token()->replace($inner_token, ['media' => $media], $options, $bubbleable_metadata);
  }
  catch (\Throwable $e) {
    \Drupal::logger('pdf_thumbnail_token')->error('Failed to generate PDF thumbnail for media @id: @message', [
      '@id' => $media->id(),
      '@message' => $e->getMessage(),
    ]);
    return $replacements;
  }

  // If the token could not be resolved, Token::replace() returns the
  // original placeholder string unchanged rather than an empty string.
  if (empty($uri) || $uri === $inner_token) {
    return $replacements;
  }

  foreach ($wanted as $name => $original) {
    if ($name === 'pdf_thumbnail_uri') {
      $replacements[$original] = $uri;
    }
    elseif ($name === 'pdf_thumbnail_url') {
      $replacements[$original] = _pdf_thumbnail_token_absolute_url($uri);
    }
  }

  return $replacements;
}

/**
 * Converts a file URI (e.g. public://...) into an absolute URL.
 *
 * Uses the file_url_generator service (Drupal 9.3+) when available, and
 * falls back to the deprecated file_create_url() for older 9.x sites.
 */
function _pdf_thumbnail_token_absolute_url(string $uri): string {
  if (\Drupal::hasService('file_url_generator')) {
    return \Drupal::service('file_url_generator')->generateAbsoluteString($uri);
  }
  // @phpstan-ignore-next-line
  return file_create_url($uri);
}
