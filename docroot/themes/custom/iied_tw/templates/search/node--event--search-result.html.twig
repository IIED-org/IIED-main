{% extends '@iied_tw/search/node--search-result.html.twig' %}
{% block meta %}
  {% set event_date = include('@iied_tw/partials/_event_date.html.twig', { node: node }, with_context = false)|trim %}
  <div class="text-stone-500">{{ node.type.entity.label() }}, {{ event_date ?: node.getCreatedTime|date('j F Y') }}</div>
{% endblock %}