{% extends '@iied_tw/node/card/node--card-lg.html.twig' %}
    {% block tagline %}
    <p class="text-stone-700">{{ node.field_tagline.0.value }}</p>
    {% endblock %}

    {% block date %}
        {% set event_date = include('@iied_tw/partials/_event_date.html.twig', { node: node }, with_context = false)|trim %}
        {% if event_date %}
            <p class="text-stone-500">{{ node.type.entity.label() }} on {{ event_date }}</p>
        {% endif %}
    {% endblock %}

   {% block lglabel %}
        <div class="absolute bottom-0 left-0 z-10 px-4 pt-2 pb-5 text-stone-900 lg:h-10 lg:top-0 lg:z-30 bg-iiedblue-500 rounded-tr-xl lg:rounded-tr-none lg:rounded-br-xl">
            {% if node.field_alternative_label is not empty %}
            {{ node.field_alternative_label.0.value|striptags }}
            {% else %}
            {{ node.type.entity.label() }}
            {% endif %}
        </div>
    {% endblock %}