{#
  Explainer card, horizontal. Same as node--article--card without the hide-date
  test. 'Explainer' is a translatable interface string: config_translation is
  not enabled, so the content type label can't be translated.

  Matched to node--explainer--card-md.html.twig on 13 September 2026: the rule
  under the date, the question mark behind it, and month and year rather than a
  full date, an explainer being evergreen. This card has no label of its own, so
  'Explainer' stays at the head of the date line.

  The mark is 48px here. This card is one row of a list, so a 70px mark would
  set the row height. The wrapper is its positioning context, as on the md card,
  so nothing is needed from the generic template.
#}
{% extends '@iied_tw/node/card/node--card.html.twig' %}

  {% block date %}
    <div class="relative mt-6">
      <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 46.842 73.808" class="absolute bottom-0 right-0 w-auto h-12 rotate-10 pointer-events-none text-iiedbg-10">
        <path fill="currentColor" d="M11.519,48.879l.167-11.973a27.508,27.508,0,0,0,9.615-4.2,17.317,17.317,0,0,0,5.233-6.1A27.51,27.51,0,0,0,29,19.036a14.573,14.573,0,0,0-.428-8.026A5.937,5.937,0,0,0,23.8,7.243,5.859,5.859,0,0,0,17.636,9.9q-2.385,3.327-3.561,9.99Q6.914,18.622,3.142,16.161A6.2,6.2,0,0,1,.126,9.422,9.576,9.576,0,0,1,3.545,3.716,16.72,16.72,0,0,1,11.624.373a37.913,37.913,0,0,1,12.9.433A37.207,37.207,0,0,1,37.37,5.331a20.24,20.24,0,0,1,7.739,7.882,15.991,15.991,0,0,1,1.434,10.461q-1.389,7.86-7.056,11.782T22.915,41.864l-3.437,8.421Zm-.473,24.743a10.282,10.282,0,0,1-5.883-2.988q-2.2-2.339-1.342-7.213.879-4.976,3.741-6.367a10.473,10.473,0,0,1,6.542-.743,10.822,10.822,0,0,1,5.843,2.931q2.361,2.316,1.484,7.289-.861,4.876-3.883,6.29a10.611,10.611,0,0,1-6.5.8"/>
      </svg>
      <p class="relative w-4/5 pb-1 border-b text-stone-500 border-iiedgreen-500">{{ 'Explainer'|t }}, {{ node.getCreatedTime|format_date('custom', 'F Y') }}</p>
    </div>
  {% endblock %}
