{#
Card for use in a slider only
#}
{% if (node.field_short_title.value) %}
	{% set title_text = node.field_short_title.value %}
{% else %}
	{% set title_text = node.label %}
{% endif %}
<div class="h-full overflow-hidden snap-center shrink-0">
	<article{{attributes.addClass('h-full')}}>
		<a href="{{ url }}" class="hover:no-underline">
			<div
				class="flex flex-col content-start h-full overflow-hidden transition-shadow bg-white border grow group rounded-xl border-stone-300">

				{# image #}
				<div class="w-full p-2 overflow-hidden max-h-44 bg-stone-300">
					<div class="m-auto overflow-hidden transition duration-300 ease-out rounded-sm shadow-lg w-fit sm:w-fit sm:-rotate-2 group-hover:-rotate-1 group-hover:scale-105">
						{% include '@iied_tw/partials/_publication_image.html.twig' with { 'display_mode':'search_cover', 'img_style':'card_cover', 'alt_text': title_text } %}
					</div>
				</div>
				{# color-rotate classes to be added #}
				<div class="p-4 border-t-2 grow border-iiedorange-500 color-rotate">
					<h5 class="mb-4 sm:text-xl sm:leading-relaxed text-stone-900">
						{{ title_text }}
					</h5>
				</div>

			</div>
		</a>

	</article>
</div>