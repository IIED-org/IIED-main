{#
/**
 * @file
 * Explainer node, full view. Based on node--article.html.twig
 *
 * Same structure as article: a header grid, the optional hero, field_content
 * (layout paragraph sections) at full width, then tags. The contents list is
 * not rendered here – editors place a toc_list paragraph in the aside of an
 * IIED main with aside section (paragraph--toc-list.html.twig).
 *
 */
#}
{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    not node.isPublished() ? 'node--unpublished',
  ]
%}
{% set published = node.getCreatedTime|format_date('custom', 'd F Y') %}
{% set updated = node.field_date_updated.value
  ? node.field_date_updated.date.getTimestamp()|format_date('custom', 'd F Y') %}

<article{{ attributes.addClass(classes) }}>
  <div class="my-6">

    {#-- header --#}
    <div class="container mx-auto lg:px-8 xl:grid xl:gap-6 md:max-w-3xl xl:max-w-screen-xl 2xl:max-w-screen-2xl xl:grid-cols-12 2xl:grid-cols-12">
      <div class="xl:col-span-7 2xl:col-span-6 xl:col-start-4 2xl:col-start-4">

        <nav aria-label="{{ 'Themes'|t }}">
          <div class="mb-4 sm:justify-between sm:flex">
            <div class="mb-2 sm:order-2">{{ drupal_block('language_block:language_interface', wrapper=false) }}</div>
            <div class="mb-2">{{ content.field_theme_s_ }}</div>
          </div>
        </nav>

        <h1 class="mb-6 text-4xl">{{ node.label }}</h1>

        {#-- standfirst: the standalone answer to the title --#}
        <div class="mb-4 prose prose-lg border-b-2 lg:prose-xl border-iiedgreen-500">
          {{ content.field_standfirst }}
        </div>

        {#-- label, dates and share --#}
        <div class="flex flex-col flex-wrap justify-between pb-6 border-b gap-y-3 border-stone-300 xl:border-none sm:flex-row sm:items-center">
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
            {% include '@iied_tw/partials/_label_chip.html.twig' with { label: 'Explainer'|t } only %}
            <p class="text-stone-700">
              <time datetime="{{ node.getCreatedTime|date('Y-m-d') }}">{% trans %}Published {{ published }}{% endtrans %}</time>
              {% if updated %}
                <span aria-hidden="true">·</span>
                <time datetime="{{ node.field_date_updated.value }}">{% trans %}Updated {{ updated }}{% endtrans %}</time>
              {% endif %}
            </p>
          </div>
          <div class="flex items-center">
            {% include '@iied_tw/partials/_share_links.html.twig' %}
          </div>
        </div>

      </div>
    </div>

    {#-- hero, only when field_display_image is set, as article; rounded from sm up --#}
    {% if node.field_display_image.value %}
      <div class="container mx-auto lg:px-8 xl:grid xl:gap-6 md:max-w-3xl xl:max-w-screen-xl 2xl:max-w-screen-2xl xl:grid-cols-12 2xl:grid-cols-12">
        <figure class="mb-6 -mx-4 sm:mx-0 xl:col-span-7 2xl:col-span-6 xl:col-start-4 2xl:col-start-4">
          <div class="sm:overflow-hidden sm:rounded-xl">
            {{ content.field_main_image[0] }}
          </div>
          <figcaption class="px-4 mt-1 text-base leading-tight text-stone-500 sm:p-0">
            {{ content.field_image_caption }}
          </figcaption>
        </figure>
      </div>
    {% endif %}

    {#-- layout paragraph sections, full width, printed as article prints them --#}
    {{ content.field_content }}

    {#-- sources, then tags, share, copy and print --#}
    <div class="container lg:px-8 xl:grid xl:gap-6 md:max-w-3xl xl:max-w-screen-xl 2xl:max-w-screen-2xl xl:grid-cols-12 2xl:grid-cols-12">
      <div class="xl:col-span-7 2xl:col-span-6 xl:col-start-4 2xl:col-start-4">
        {% if node.field_additional_resources.value %}
          <section class="pt-6 mb-8 border-t border-stone-300" aria-labelledby="sources-heading">
            <h2 id="sources-heading" class="mb-3 text-2xl">{% trans %}Sources{% endtrans %}</h2>
            <div class="prose text-base [&_ol]:pl-5">
              {{ content.field_additional_resources }}
            </div>
          </section>
        {% endif %}
        <div class="border-t border-stone-300">
          {{ content.field_tags }}
          <div class="flex items-center py-4">
            {% include '@iied_tw/partials/_share_links.html.twig' %}
            {% include '@iied_tw/partials/_copy_print_links.html.twig' %}
          </div>
        </div>
      </div>
    </div>

  </div>
</article>
{% include '@iied_tw/partials/_related_nodes_explainer.html.twig' %}
