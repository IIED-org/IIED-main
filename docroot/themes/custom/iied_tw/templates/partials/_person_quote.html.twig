{#
/**
 * @file
 * Person quote: the pink quote mark, the quote in the headline serif, then the
 * speaker's photo and a citation. Shared by the 'Quote with a person' block and
 * the explainer's Person quote paragraph, so the two cannot drift apart.
 *
 * Variables:
 * - quote: the rendered quote.
 * - author: optional – the rendered person in the avatar view mode, which
 *   prints the photo alone. Pass it only when the person has a photo.
 * - citation: optional – the rendered citation.
 * - width: 'standard' (the default) – quote, then photo and citation beneath,
 *   held to max-w-2xl so a quote in a full-width section keeps a reading width;
 *   or 'wide' – from md, the quote on the left and the photo and citation on
 *   the right, centred on each other.
 *
 * The photo is forced to 64px whatever the avatar template draws. The quote
 * mark leans a few degrees and does not move on hover; it is decoration, so it
 * is hidden from screen readers.
 */
#}
{% set wide = width == 'wide' %}

<figure class="{{ wide ? 'text-iiedpink-500 md:grid md:grid-cols-2 md:items-center md:gap-12' : 'max-w-3xl text-iiedpink-500' }}">
  <div>
    <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="48" height="38" viewBox="0 0 47.948 37.814" class="mb-2 -rotate-3">
      <path fill="currentColor" d="M11.369,37.814a10.3,10.3,0,0,1-8.28-3.645Q0,30.526,0,24.22A23.081,23.081,0,0,1,5.067,9.762Q10.132,3.214,22.12,0V6.426a34.183,34.183,0,0,0-8.094,4.015,6.59,6.59,0,0,0-2.781,5.623A3.021,3.021,0,0,0,12.6,18.719q1.359.927,3.152,1.976a10.262,10.262,0,0,1,3.151,2.962,9.684,9.684,0,0,1,1.359,5.622,7.906,7.906,0,0,1-2.533,6.365,9.461,9.461,0,0,1-6.365,2.162m25.828,0a10.3,10.3,0,0,1-8.28-3.645q-3.089-3.643-3.089-9.948a23.271,23.271,0,0,1,5-14.459Q35.838,3.214,47.948,0V6.426a32.449,32.449,0,0,0-8.156,4.015,6.638,6.638,0,0,0-2.719,5.623,3.021,3.021,0,0,0,1.359,2.655q1.359.927,3.152,1.976a10.262,10.262,0,0,1,3.151,2.962,9.684,9.684,0,0,1,1.359,5.622,7.906,7.906,0,0,1-2.533,6.365A9.46,9.46,0,0,1,37.2,37.806"/>
    </svg>
    <blockquote class="text-xl md:text-2xl font-headline text-iiedpink-700">
      {{ quote }}
    </blockquote>
  </div>
  {% if author or citation %}
    <figcaption class="{{ wide ? 'flex items-center gap-4 mt-6 md:mt-0' : 'flex items-center gap-4 mt-6' }} font-sans text-base text-stone-700 [&_img]:w-16 [&_img]:h-16">
      {% if author %}
        <div class="shrink-0">{{ author }}</div>
      {% endif %}
      {% if citation %}
        <div>{{ citation }}</div>
      {% endif %}
    </figcaption>
  {% endif %}
</figure>
